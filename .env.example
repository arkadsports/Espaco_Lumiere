# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel (produção).

# Banco Postgres (Neon). Na Vercel: Storage > Neon > Connect Project preenche DATABASE_URL sozinho.
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# Painel /admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
SESSION_SECRET=gere-com-openssl-rand-hex-32

# URL pública do site
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# Agente de IA no WhatsApp
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
WHATSAPP_TOKEN=            # token permanente da WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=  # ID do número no painel da Meta
WHATSAPP_VERIFY_TOKEN=     # texto qualquer, igual ao cadastrado no webhook
WHATSAPP_APP_SECRET=       # segredo do app Meta (valida a assinatura do webhook)
OWNER_WHATSAPP=            # opcional: número que recebe aviso quando a cliente pede atendente (ex.: 5584996644614)

# Regras da agenda (opcionais)
# SLOT_STEP_MIN=30         # intervalo entre inícios possíveis
# MIN_LEAD_HOURS=3         # antecedência mínima para agendar
# MAX_DAYS_AHEAD=60        # até quantos dias à frente
# CANCEL_MIN_HOURS=4       # cancelamento online até X horas antes
